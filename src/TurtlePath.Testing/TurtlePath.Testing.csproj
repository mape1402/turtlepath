<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TurtlePath.Testing</PackageId>
    <Description>Testing harness, fake adapters, and in-memory storage helpers for TurtlePath handlers and automations.</Description>
    <PackageTags>testing cqrs handlers automations pelican turtlepath</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TurtlePath\TurtlePath.csproj" />
    <ProjectReference Include="..\TurtlePath.Automations\TurtlePath.Automations.csproj" />
    <ProjectReference Include="..\TurtlePath.ExceptionHandling\TurtlePath.ExceptionHandling.csproj" />
    <ProjectReference Include="..\TurtlePath.Jobs\TurtlePath.Jobs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" Condition="'$(CI)' == 'true'" />
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
    <PackageReference Include="Pelican.Mediator" Version="1.1.2" />
  </ItemGroup>
</Project>

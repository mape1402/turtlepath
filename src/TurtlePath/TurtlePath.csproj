<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TurtlePath</PackageId>
    <Description>TurtlePath provides reusable Pelican handler foundations, hooks, storage adapters, validation, mapping, and entity primitives extracted from the Elysium template.</Description>
    <PackageTags>pelican mediator handlers cqrs hooks entity-framework octomap crabalidator turtlepath elysium</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TurtlePath.Application\TurtlePath.Application.csproj" />
    <ProjectReference Include="..\TurtlePath.AspNetCore\TurtlePath.AspNetCore.csproj" />
    <ProjectReference Include="..\TurtlePath.Crabalidator\TurtlePath.Crabalidator.csproj" />
    <ProjectReference Include="..\TurtlePath.Domain\TurtlePath.Domain.csproj" />
    <ProjectReference Include="..\TurtlePath.EntityFrameworkCore\TurtlePath.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\TurtlePath.Identifier\TurtlePath.Identifier.csproj" />
    <ProjectReference Include="..\TurtlePath.Mapping.Abstractions\TurtlePath.Mapping.Abstractions.csproj" />
    <ProjectReference Include="..\TurtlePath.OctoMap\TurtlePath.OctoMap.csproj" />
    <ProjectReference Include="..\TurtlePath.Persistence.Abstractions\TurtlePath.Persistence.Abstractions.csproj" />
    <ProjectReference Include="..\TurtlePath.Sieve\TurtlePath.Sieve.csproj" />
    <ProjectReference Include="..\TurtlePath.Swagger\TurtlePath.Swagger.csproj" />
    <ProjectReference Include="..\TurtlePath.Validation.Abstractions\TurtlePath.Validation.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.7" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
    <PackageReference Include="Pelican.Mediator" Version="1.1.2" />
  </ItemGroup>
</Project>

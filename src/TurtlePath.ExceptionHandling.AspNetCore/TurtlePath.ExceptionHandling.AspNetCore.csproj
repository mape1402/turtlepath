<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TurtlePath.ExceptionHandling.AspNetCore</PackageId>
    <Description>ASP.NET Core exception handling adapters for TurtlePath exception handling core.</Description>
    <PackageTags>exceptions aspnetcore problem-details turtlepath</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TurtlePath.ExceptionHandling\TurtlePath.ExceptionHandling.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" Condition="'$(CI)' == 'true'" />
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>

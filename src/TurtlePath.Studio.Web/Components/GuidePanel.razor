<section class="studio-panel guide-panel @(Compact ? "compact" : null)">
    <div class="panel-heading">
        <p>Usage guide</p>
        <h2>@Title</h2>
    </div>

    <div class="guide-copy">
        @foreach (var item in Items)
        {
            <article>
                <span>@item.Number</span>
                <div>
                    <strong>@item.Title</strong>
                    <p>@item.Description</p>
                </div>
            </article>
        }
    </div>
</section>

@code {
    [Parameter] public ProjectHostMode HostMode { get; set; }

    [Parameter] public bool Compact { get; set; }

    private string Title => HostMode == ProjectHostMode.Job
        ? "One-shot job flow"
        : "API / Consumer flow";

    private IReadOnlyList<GuideItem> Items => HostMode == ProjectHostMode.Job
        ? JobItems
        : ApiItems;

    private static readonly IReadOnlyList<GuideItem> ApiItems =
    [
        new("01", "Generated structure", "The template creates Domain, Persistence, Business, API and Tests projects with the recommended TurtlePath feature layout."),
        new("02", "Feature folders", "Replace the placeholder Feature folder with real feature names such as Customers or Invoices, keeping Commands, Queries, Validators, Mappings, Hooks, Automations and Models organized."),
        new("03", "Adapters ready", "DataScorpio, OctoMap, Crabalidator, Pigeon, Spider and Pelican are wired from the API composition root."),
        new("04", "Testing base", "The generated tests include the base host configuration so developers can focus on the business behavior they add.")
    ];

    private static readonly IReadOnlyList<GuideItem> JobItems =
    [
        new("01", "Job host", "The template creates a job-focused host for one-shot execution, useful for Kubernetes CronJobs or manually triggered workloads."),
        new("02", "Dependency setup", "The same Business, Persistence and testing foundations are available without carrying the REST API host."),
        new("03", "Job registration", "Register one or more TurtlePath jobs through dependency injection and let the job manager execute the configured work."),
        new("04", "Operational behavior", "Use TurtlePath exception handling and jobs support to keep failures controlled and observable.")
    ];

    private sealed record GuideItem(string Number, string Title, string Description);
}

<section class="status-panel" aria-label="Environment status">
    @if (Report is null)
    {
        <span class="status-pill pending">Not checked</span>
    }
    else
    {
        <span class="status-pill @(Report.DotNet.IsAvailable ? "ok" : "error")">
            .NET @(Report.DotNet.IsAvailable ? Report.DotNet.Version : "missing")
        </span>
        <span class="status-pill @(Report.Template.IsInstalled ? "ok" : "pending")">
            Template @(Report.Template.IsInstalled ? Report.Template.Version : "not installed")
        </span>
    }
</section>

@code {
    [Parameter] public StudioEnvironmentReport Report { get; set; }
}

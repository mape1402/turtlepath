@using TurtlePath.Studio.Abstractions.Validation
@using TurtlePath.Studio.Abstractions.Workspace
@using TurtlePath.Studio.Application.UseCases
@inject InspectStudioEnvironmentUseCase InspectEnvironment
@inject InstallTemplateUseCase InstallTemplate
@inject CreateTurtlePathProjectUseCase CreateProject
@inject IStudioWorkspaceService Workspace

<main class="studio-shell">
    <aside class="studio-rail">
        <div class="studio-brand">
            <span class="studio-brand-mark">TP</span>
            <div>
                <strong>TurtlePath Studio</strong>
                <span>Template launcher</span>
            </div>
        </div>

        <div class="rail-status">
            <EnvironmentStatus Report="environment" />
        </div>

        <ol class="wizard-steps">
            <li class="@(step == WizardStep.ChooseTemplate ? "current" : IsPast(WizardStep.ChooseTemplate) ? "done" : null)">Choose</li>
            <li class="@(step == WizardStep.ConfigureProject ? "current" : IsPast(WizardStep.ConfigureProject) ? "done" : null)">Configure</li>
            <li class="@(step == WizardStep.CreateProject ? "current" : IsPast(WizardStep.CreateProject) ? "done" : null)">Create</li>
            <li class="@(step == WizardStep.Documentation ? "current" : null)">Guide</li>
        </ol>
    </aside>

    <section class="studio-workspace">
        <header class="workspace-header">
            <div>
                <p>TurtlePath project generator</p>
                <h1>@Title</h1>
            </div>

            <button type="button" class="ghost-action" @onclick="RefreshEnvironment" disabled="@busy">
                Refresh
            </button>
        </header>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="message @(messageIsError ? "error" : "ok")">@message</div>
        }

        @switch (step)
        {
            case WizardStep.ChooseTemplate:
                <section class="option-carousel" aria-label="Project types">
                    @foreach (var option in ProjectOptions)
                    {
                        <button type="button"
                                class="project-card @(selectedHost == option.HostMode ? "selected" : null)"
                                @onclick="() => SelectOption(option.HostMode)">
                            <span class="card-icon">@option.Icon</span>
                            <span class="card-kicker">@option.Kicker</span>
                            <strong>@option.Title</strong>
                            <span>@option.Description</span>
                        </button>
                    }
                </section>

                <div class="footer-actions">
                    <button type="button" class="primary-action" @onclick="GoToConfigure">Continue</button>
                </div>
                break;

            case WizardStep.ConfigureProject:
                <section class="configure-layout">
                    <div class="studio-panel">
                        <div class="panel-heading">
                            <p>Project details</p>
                            <h2>@SelectedOption.Title</h2>
                        </div>

                        <div class="field-stack">
                            <label>
                                <span>Project name</span>
                                <input @bind="projectName" @bind:event="oninput" placeholder="BillingService" />
                            </label>

                            <label>
                                <span>Destination folder</span>
                                <div class="browse-row">
                                    <input @bind="outputRoot" @bind:event="oninput" placeholder="C:\work" />
                                    <button type="button" class="secondary-action" @onclick="PickFolder" disabled="@busy">Browse</button>
                                </div>
                            </label>

                            <div class="preview-path">
                                <span>Project will be created at</span>
                                <strong>@ProjectDirectoryPreview</strong>
                            </div>

                            <div class="checks">
                                <label><input type="checkbox" @bind="restoreAfterCreation" /> Restore</label>
                                <label><input type="checkbox" @bind="buildAfterCreation" /> Build</label>
                                <label><input type="checkbox" @bind="testAfterCreation" /> Test</label>
                            </div>
                        </div>
                    </div>

                    <GuidePanel HostMode="selectedHost" Compact="true" />
                </section>

                <div class="footer-actions">
                    <button type="button" class="secondary-action" @onclick="BackToChoose" disabled="@busy">Back</button>
                    <button type="button" class="primary-action" @onclick="GoToCreate" disabled="@busy">Create project</button>
                </div>
                break;

            case WizardStep.CreateProject:
                <section class="create-layout">
                    <div class="studio-panel progress-panel">
                        <div class="panel-heading">
                            <p>Execution</p>
                            <h2>@(busy ? "Creating project" : created ? "Project created" : "Ready")</h2>
                        </div>

                        <div class="progress-mark @(created ? "done" : busy ? "running" : null)">
                            @(created ? "Done" : busy ? "Working" : "Ready")
                        </div>

                        @if (created)
                        {
                            <p class="created-path">@createdDirectory</p>
                            <div class="checks">
                                <label><input type="checkbox" @bind="HideDocsAfterCreation" /> Do not show the guide after creating projects</label>
                            </div>
                        }
                    </div>

                    <ExecutionLog Commands="commands" />
                </section>

                <div class="footer-actions">
                    <button type="button" class="secondary-action" @onclick="BackToConfigure" disabled="@busy">Back</button>
                    @if (created)
                    {
                        <button type="button" class="secondary-action" @onclick="OpenCreatedFolder">Open folder</button>
                        <button type="button" class="primary-action" @onclick="Finish">Continue</button>
                    }
                </div>
                break;

            case WizardStep.Documentation:
                <section class="documentation-layout">
                    <GuidePanel HostMode="selectedHost" Compact="false" />
                    <ExecutionLog Commands="commands" />
                </section>

                <div class="footer-actions">
                    <button type="button" class="secondary-action" @onclick="StartOver">Create another project</button>
                    <button type="button" class="primary-action" @onclick="OpenCreatedFolder">Open folder</button>
                </div>
                break;
        }
    </section>
</main>

@code {
    private StudioEnvironmentReport environment;
    private ProjectHostMode selectedHost = ProjectHostMode.ApiConsumer;
    private WizardStep step = WizardStep.ChooseTemplate;
    private string projectName = "MyService";
    private string outputRoot = Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments);
    private bool restoreAfterCreation = true;
    private bool buildAfterCreation = true;
    private bool testAfterCreation = true;
    private bool busy;
    private bool created;
    private string createdDirectory;
    private string message;
    private bool messageIsError;
    private IReadOnlyList<CommandExecutionResult> commands = [];

    private static readonly IReadOnlyList<ProjectOption> ProjectOptions =
    [
        new(ProjectHostMode.ApiConsumer, "API", "API / Consumer", "REST API and message consumer host with TurtlePath defaults.", "API"),
        new(ProjectHostMode.Job, "JOB", "One-shot Job", "Console-style job host for Kubernetes CronJobs and scheduled execution.", "JOB")
    ];

    private ProjectOption SelectedOption => ProjectOptions.First(option => option.HostMode == selectedHost);

    private string Title => step switch
    {
        WizardStep.ChooseTemplate => "What are we creating today?",
        WizardStep.ConfigureProject => "Name it and choose where it lives",
        WizardStep.CreateProject => "Creating your project",
        WizardStep.Documentation => "Project guide",
        _ => "TurtlePath Studio"
    };

    private string ProjectDirectoryPreview => string.IsNullOrWhiteSpace(projectName) || string.IsNullOrWhiteSpace(outputRoot)
        ? "Complete the project name and destination folder"
        : Path.Combine(outputRoot, projectName);

    protected override Task OnInitializedAsync()
    {
        message = "Ready. Use Refresh when you want to check the local .NET and template environment.";
        messageIsError = false;
        return Task.CompletedTask;
    }

    private async Task RefreshEnvironment()
    {
        await RunAsync(async () =>
        {
            environment = await InspectEnvironment.ExecuteAsync();
            message = environment.CanCreateProjects
                ? "Environment ready."
                : "Template or .NET environment is not ready. Creating a project may fail until the template is installed.";
            messageIsError = !environment.CanCreateProjects;
        });
    }

    private void SelectOption(ProjectHostMode hostMode)
    {
        selectedHost = hostMode;
        projectName = hostMode == ProjectHostMode.Job ? "BillingJob" : "BillingService";
    }

    private void GoToConfigure()
    {
        ClearMessage();
        step = WizardStep.ConfigureProject;
    }

    private void BackToChoose()
    {
        ClearMessage();
        step = WizardStep.ChooseTemplate;
    }

    private void BackToConfigure()
    {
        ClearMessage();
        step = WizardStep.ConfigureProject;
    }

    private async Task PickFolder()
    {
        outputRoot = await Workspace.PickOutputDirectoryAsync(outputRoot);
    }

    private async Task GoToCreate()
    {
        if (!ValidateInput())
            return;

        step = WizardStep.CreateProject;
        created = false;
        commands = [];

        await RunAsync(async () =>
        {
            var result = await CreateProject.ExecuteAsync(new CreateProjectRequest(
                projectName.Trim(),
                ProjectDirectoryPreview,
                selectedHost,
                restoreAfterCreation,
                buildAfterCreation,
                testAfterCreation));

            commands = CollectCommands(result).ToArray();
            created = result.Succeeded;
            createdDirectory = result.Creation.ProjectDirectory;

            message = result.Succeeded
                ? "Project created successfully."
                : "Project creation finished with errors. Check the execution log.";
            messageIsError = !result.Succeeded;

            if (result.Succeeded)
                await Workspace.OpenDirectoryAsync(createdDirectory);
        });
    }

    private async Task OpenCreatedFolder()
    {
        await Workspace.OpenDirectoryAsync(createdDirectory);
    }

    private void Finish()
    {
        step = HideDocsAfterCreation ? WizardStep.ChooseTemplate : WizardStep.Documentation;
    }

    private void StartOver()
    {
        ClearMessage();
        created = false;
        commands = [];
        createdDirectory = null;
        step = WizardStep.ChooseTemplate;
    }

    private bool ValidateInput()
    {
        if (string.IsNullOrWhiteSpace(projectName))
        {
            SetError("Project name is required.");
            return false;
        }

        if (projectName.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0)
        {
            SetError("Project name contains invalid characters.");
            return false;
        }

        if (string.IsNullOrWhiteSpace(outputRoot))
        {
            SetError("Destination folder is required.");
            return false;
        }

        ClearMessage();
        return true;
    }

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;

        try
        {
            await action();
        }
        catch (Exception exception)
        {
            SetError(exception.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private static IEnumerable<CommandExecutionResult> CollectCommands(CreateTurtlePathProjectUseCaseResult result)
    {
        yield return result.Creation.Generation;

        if (result.Validation is null)
            yield break;

        foreach (ProjectValidationStepResult step in result.Validation.Steps)
            yield return step.Execution;
    }

    private void SetError(string text)
    {
        message = text;
        messageIsError = true;
    }

    private void ClearMessage()
    {
        message = null;
        messageIsError = false;
    }

    private bool IsPast(WizardStep target) => step > target;

    private bool HideDocsAfterCreation { get; set; }

    private enum WizardStep
    {
        ChooseTemplate = 0,
        ConfigureProject = 1,
        CreateProject = 2,
        Documentation = 3
    }

    private sealed record ProjectOption(
        ProjectHostMode HostMode,
        string Icon,
        string Title,
        string Description,
        string Kicker);
}

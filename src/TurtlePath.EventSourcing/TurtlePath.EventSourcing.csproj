<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TurtlePath.EventSourcing</PackageId>
    <Description>Event sourcing bridge for TurtlePath command handlers and hooks.</Description>
    <PackageTags>event-sourcing cqrs handlers hooks turtlepath krackend</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TurtlePath\TurtlePath.csproj" />
    <ProjectReference Include="..\TurtlePath.Abstractions\TurtlePath.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krackend.EventSourcing" Version="1.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" Condition="'$(CI)' == 'true'" />
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>

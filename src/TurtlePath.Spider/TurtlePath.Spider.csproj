<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TurtlePath.Spider</PackageId>
    <Description>Spider pipeline extensions for dispatching Pelican requests through TurtlePath applications.</Description>
    <PackageTags>turtlepath spider pelican mediator pipelines bridge</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" Condition="'$(CI)' == 'true'" />
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
    <PackageReference Include="Pelican.Mediator" Version="1.1.2" />
    <PackageReference Include="Spider.Pipelines" Version="2.1.0" />
  </ItemGroup>
</Project>

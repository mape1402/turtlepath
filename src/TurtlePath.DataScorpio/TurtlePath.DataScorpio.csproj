    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TurtlePath.DataScorpio</PackageId>
    <Description>DataScorpio criteria adapter for TurtlePath persistence abstractions.</Description>
    <PackageTags>data-scorpio filtering sorting persistence turtlepath elysium</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TurtlePath.Abstractions\TurtlePath.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\data-scorpio\src\DataScorpio\DataScorpio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" Condition="'$(CI)' == 'true'" />
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>

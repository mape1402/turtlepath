{
  "author": "TurtlePath",
  "classifications": [ "TurtlePath", "Demo", "Showcase", "CQRS" ],
  "name": "TurtlePath Heroes Showcase",
  "identity": "TurtlePath.HeroesShowcase",
  "shortName": "turtlepath-heroes-showcase",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "Heroes.Service",
  "preferNameDirectory": true,
  "sources": [
    {
      "exclude": [
        ".git/**",
        ".template.config/**",
        ".vs/**",
        "**/bin/**",
        "**/obj/**",
        "**/*.db",
        "**/*.db-shm",
        "**/*.db-wal"
      ]
    }
  ],
  "symbols": {
    "turtlepath-version": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "1.4.1",
      "replaces": "TURTLEPATH_VERSION",
      "description": "Sets the TurtlePath NuGet package version used by the generated demo project."
    }
  }
}

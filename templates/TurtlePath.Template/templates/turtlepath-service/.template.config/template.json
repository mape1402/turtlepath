{
    "author": "Elysium Coding",
    "classifications": [ "TurtlePath", "Microservice", "CQRS" ],
    "name": "TurtlePath Service",
    "identity": "TurtlePath.Service",
    "shortName": "turtlepath",
    "tags": { 
        "language": "C#",
        "type": "project"
    },
    "sourceName": "TurtlePath.Template",
    "preferNameDirectory" : "true",
    "sources": [
        {
            "copyOnly": [
                "turtlepath.template.json"
            ],
            "exclude": [
                ".git/**",
                ".template.config/**",
                ".vs/**",
                "**/bin/**",
                "**/obj/**"
            ],
            "modifiers": [
                {
                    "condition": "(host == \"job\")",
                    "exclude": [
                        "src/TurtlePath.Template.Api/Controllers/**",
                        "src/TurtlePath.Template.Api/HubConsumers/**",
                        "src/TurtlePath.Template.Api/Swagger/**",
                        "src/TurtlePath.Template.Api/DependencyInjection/HealthCheckExtensions.cs",
                        "src/TurtlePath.Template.Api/DependencyInjection/MessagingExtensions.cs",
                        "src/TurtlePath.Template.Api/DependencyInjection/MvcExtensions.cs",
                        "src/TurtlePath.Template.Api/DependencyInjection/SwaggerExtensions.cs",
                        "tests/TurtlePath.Template.Tests/TemplateCompositionTests.cs"
                    ]
                },
                {
                    "condition": "(host != \"job\")",
                    "exclude": [
                        "tests/TurtlePath.Template.Tests/JobCompositionTests.cs"
                    ]
                }
            ]
        }
    ],
    "symbols":{
        "host": {
            "type": "parameter",
            "datatype": "choice",
            "defaultValue": "api-consumer",
            "description": "Selects the generated host composition.",
            "replaces": "TurtlePath.TemplateHostMode",
            "choices": [
                {
                    "choice": "api-consumer",
                    "description": "Generates the default API host with REST controllers and Pigeon consumers."
                },
                {
                    "choice": "job",
                    "description": "Generates a one-shot job host intended for console or Kubernetes CronJob execution."
                }
            ]
        },
        "turtlepath-version": {
            "type": "parameter",
            "datatype": "text",
            "defaultValue": "1.6.3",
            "replaces": "TURTLEPATH_VERSION",
            "description": "Sets the TurtlePath NuGet package version used by the generated project."
        },
        "JobHost": {
            "type": "computed",
            "value": "(host == \"job\")"
        },
        "HostProjectSuffix": {
            "type": "generated",
            "generator": "switch",
            "datatype": "string",
            "parameters": {
                "evaluator": "C++",
                "cases": [
                    {
                        "condition": "(host == \"job\")",
                        "value": "Job"
                    },
                    {
                        "condition": "(host == \"api-consumer\")",
                        "value": "Api"
                    }
                ]
            }
        },
        "HostProjectName": {
            "type": "generated",
            "generator": "join",
            "replaces": "TurtlePath.Template.Api",
            "fileRename": "TurtlePath.Template.Api",
            "parameters": {
                "symbols": [
                    {
                        "type": "ref",
                        "value": "name"
                    },
                    {
                        "type": "ref",
                        "value": "HostProjectSuffix"
                    }
                ],
                "separator": ".",
                "removeEmptyValues": true
            }
        }
    }
}
